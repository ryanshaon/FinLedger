# FinLedger development configuration
# Copy this file to .env and replace every mock_/change-me value before production.
# Never commit .env, Supabase service-role keys, database passwords, or live AI provider keys.

FINLEDGER_ENV=development
FINLEDGER_ALLOW_MOCK_KEYS=true

# PostgreSQL / future Supabase Postgres
# App role is subject to RLS. Owner role is used only for migrations/bootstrap.
FINLEDGER_DATABASE_URL=postgresql://fl_app:mock_local_password@127.0.0.1:5432/finledger
FINLEDGER_OWNER_DATABASE_URL=postgresql://postgres:mock_local_owner_password@127.0.0.1:5432/finledger

# Supabase API/Auth placeholders — staging schema exists, but runtime is not connected yet
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=mock_supabase_anon_key_not_for_production
SUPABASE_SERVICE_ROLE_KEY=mock_supabase_service_role_key_not_for_production
SUPABASE_JWT_SECRET=mock_supabase_jwt_secret_not_for_production
SUPABASE_STORAGE_BUCKET=finledger-documents-dev

# Public application URLs
FINLEDGER_APP_BASE_URL=http://127.0.0.1:8000
FINLEDGER_CONTROL_BASE_URL=http://127.0.0.1:8770

# Signing/encryption
FINLEDGER_SIGNING_SECRET=mock_signing_secret_change_before_production_32_chars
# Valid Fernet-shaped development key made from zero bytes. It is public and unsafe for real credentials.
FINLEDGER_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Object storage: local for now; switch to s3 after configuring Supabase/S3-compatible storage.
FINLEDGER_STORE=local
FINLEDGER_STORE_ROOT=./var/objects
FINLEDGER_S3_BUCKET=
# For Supabase Storage: https://<project-ref>.supabase.co/storage/v1/s3
FINLEDGER_S3_ENDPOINT_URL=
FINLEDGER_S3_REGION=ap-south-1
FINLEDGER_S3_ADDRESSING_STYLE=path
# auto uses AES256 on AWS S3 and omits the unsupported SSE header on Supabase.
FINLEDGER_S3_SERVER_SIDE_ENCRYPTION=auto
AWS_ACCESS_KEY_ID=mock_aws_access_key_not_for_production
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key_not_for_production
AWS_DEFAULT_REGION=ap-south-1

# Inbound email / vendor replies
FINLEDGER_INBOUND_DOMAIN=inbound.localhost
FINLEDGER_INBOUND_WEBHOOK_SECRET=mock_inbound_webhook_secret_not_for_production
FINLEDGER_INBOUND_AUTHSERV_ID=mx.inbound.localhost
RESEND_API_KEY=re_mock_email_key_not_for_production
RESEND_FROM_EMAIL=bills@example.invalid
FINLEDGER_FROM_EMAIL=bills@localhost

# Virus scanning
# eicar is the local test scanner. Production must use clamd.
FINLEDGER_VIRUS_SCANNER=eicar
FINLEDGER_CLAMD_HOST=127.0.0.1
FINLEDGER_CLAMD_PORT=3310

# Upload and intake limits
FINLEDGER_MAX_UPLOAD_BYTES=26214400
FINLEDGER_RATE_PER_TOKEN_HOUR=120
FINLEDGER_RATE_PER_IP_HOUR=60
FINLEDGER_RENDER_PAGE_CAP=30

# Person 1 provider placeholders — intentionally invalid
FINLEDGER_LLM_PROVIDER=mock
OPENAI_API_KEY=sk-mock-openai-key-not-for-production
ANTHROPIC_API_KEY=sk-ant-mock-anthropic-key-not-for-production
GEMINI_API_KEY=mock-gemini-key-not-for-production
FINLEDGER_EMBEDDING_MODEL=mock-embedding-model
FINLEDGER_MODEL_EXTRACT=mock-extract-model
FINLEDGER_MODEL_EXTRACT_VISION=mock-extract-vision-model
FINLEDGER_MODEL_RISK=mock-risk-model
FINLEDGER_MODEL_MAP=mock-map-model
FINLEDGER_MODEL_SUMMARY=mock-summary-model
FINLEDGER_PER_BILL_TOKEN_CAP=12000
FINLEDGER_LLM_KILL_SWITCH=true

# Person 4 local Tally agent placeholders
FINLEDGER_TALLY_AGENT_URL=http://127.0.0.1:9000
FINLEDGER_TALLY_AGENT_TOKEN=mock_tally_agent_token_not_for_production

