# Compatibility copy for running Person 2 by itself.
# The complete shared template is ../.env.example. All values here are placeholders.
# App connects as a member of finledger_app (never the table owner). Migrations use the owner DSN.
FINLEDGER_DATABASE_URL=postgresql://fl_app:mock_local_password@localhost:5432/finledger
FINLEDGER_OWNER_DATABASE_URL=postgresql://postgres:mock_local_owner_password@localhost:5432/finledger
FINLEDGER_APP_BASE_URL=http://127.0.0.1:8000
FINLEDGER_SIGNING_SECRET=mock_signing_secret_change_before_production_32_chars
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINLEDGER_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
FINLEDGER_STORE=local            # local | s3
FINLEDGER_STORE_ROOT=./var/objects
FINLEDGER_S3_BUCKET=
FINLEDGER_INBOUND_DOMAIN=inbound.localhost
FINLEDGER_INBOUND_WEBHOOK_SECRET=mock_inbound_webhook_secret_not_for_production
FINLEDGER_INBOUND_AUTHSERV_ID=mx.inbound.localhost   # authserv-id of OUR MTA's Authentication-Results
FINLEDGER_VIRUS_SCANNER=eicar    # local mock scanner; production must use clamd
FINLEDGER_CLAMD_HOST=127.0.0.1
FINLEDGER_CLAMD_PORT=3310
FINLEDGER_MAX_UPLOAD_BYTES=26214400
FINLEDGER_RATE_PER_TOKEN_HOUR=120
FINLEDGER_RATE_PER_IP_HOUR=60
FINLEDGER_RENDER_PAGE_CAP=30
